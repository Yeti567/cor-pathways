# Copy to .env.local and fill in. Nothing here is optional-but-secretly-required:
# where a section says optional, the app runs without it and the feature it powers
# is simply unavailable.
#
# Never commit .env.local. It is gitignored.

# ---------------------------------------------------------------------------
# Supabase. REQUIRED. This is the only section you need to run the app.
# ---------------------------------------------------------------------------
# Create a project at https://supabase.com, then find these under
# Project Settings > API. The URL looks like https://<your-project-ref>.supabase.co
#
# The service role key bypasses row level security. It is a server-only secret:
# never expose it to the browser, and never hand it to anyone you would not hand
# the whole database to.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, used only when PUBLISHABLE_KEY is empty. Older projects call
# this the "anon" key. Set one or the other, not both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App. REQUIRED.
# ---------------------------------------------------------------------------
# Your own deployment's URL. Used to build email confirmation links and OAuth
# redirects, so a wrong value sends your users somewhere else.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Shared secret for the scheduled jobs in vercel.json (certification reminders,
# ELD sync). Any long random string. Without it those endpoints refuse to run.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional: single sign-on
# ---------------------------------------------------------------------------
# A Supabase auth provider slug, for example "azure" or "google". Leave empty for
# email and password sign-in only.
NEXT_PUBLIC_SSO_PROVIDER=

# ---------------------------------------------------------------------------
# Optional: PDF-to-form import
# ---------------------------------------------------------------------------
# Turns an uploaded blank PDF into a live form. Two services working together:
# Google Document AI finds the fields on the page, then a model on OpenRouter
# works out what each field means. Without these, build forms by hand.
#
# Supply the Google credentials ONE of three ways: a path to a key file, the JSON
# inline, or the JSON base64-encoded (easiest on Vercel).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS_BASE64=
GCP_PROJECT_ID=
GCP_DOCAI_PROCESSOR_ID=
GCP_DOCAI_LOCATION=

OPENROUTER_API_KEY=
OPENROUTER_FORM_IMPORT_MODEL=google/gemini-3.5-flash
OPENROUTER_SITE_URL=http://127.0.0.1:3000
OPENROUTER_APP_NAME=Cor Pathways

# ---------------------------------------------------------------------------
# Optional: outbound email (Auto-Share)
# ---------------------------------------------------------------------------
# Emails completed forms to the right people. The app queues mail and posts it to
# a webhook; the built-in relay at /api/email-delivery sends it through Resend.
# Point the webhook URL at your own deployment:
#   https://<your-app-domain>/api/email-delivery
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_DELIVERY_FROM=
RESEND_API_KEY=
# Optional. When set, outbound mail is sent from EMAIL_DELIVERY_FROM (e.g. a
# no-reply address) but replies route here (e.g. a monitored inbox). Leave empty
# to send with no Reply-To.
EMAIL_DELIVERY_REPLY_TO=

# ---------------------------------------------------------------------------
# Optional: Motive ELD
# ---------------------------------------------------------------------------
# Pulls driver duty status and vehicle data from Motive. Register a developer app
# at https://developer.gomotive.com. The redirect URI defaults to
# ${NEXT_PUBLIC_APP_URL}/api/eld/motive/callback; set it only to override.
MOTIVE_CLIENT_ID=
MOTIVE_CLIENT_SECRET=
MOTIVE_REDIRECT_URI=
# Defaults to https://api.gomotive.com. Set this only to point at a mock or a
# different Motive environment.
MOTIVE_API_BASE=

# ---------------------------------------------------------------------------
# Set for you on Vercel. Leave empty locally.
# ---------------------------------------------------------------------------
# Stamps the build so every device picks up a new version within 30 minutes.
NEXT_PUBLIC_BUILD_ID=
