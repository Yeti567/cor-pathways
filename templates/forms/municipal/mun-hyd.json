{
  "formCode": "MUN-HYD",
  "name": "Fire hydrant inspection",
  "description": "Visual and operational check of one hydrant. Fill in one form per hydrant.",
  "sections": [
    {
      "title": "Inspection details",
      "items": [
        {
          "label": "Date",
          "fieldType": "date",
          "required": true,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        },
        {
          "label": "Inspected by",
          "fieldType": "worker_select",
          "required": true,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "workerPickerScope": "current_worker"
          }
        },
        {
          "label": "Hydrant number or address",
          "fieldType": "short_text",
          "required": true,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        },
        {
          "label": "Location",
          "fieldType": "gps_coordinates",
          "required": false,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        }
      ]
    },
    {
      "title": "Visual",
      "items": [
        {
          "label": "Hydrant is upright, undamaged and not leaning",
          "fieldType": "pass_fail_na",
          "required": true,
          "flaggable": true,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "severity": "major",
            "autoWorkOrder": true
          }
        },
        {
          "label": "Clear access with nothing blocking it",
          "fieldType": "pass_fail_na",
          "required": true,
          "flaggable": true,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "severity": "major",
            "autoWorkOrder": true
          }
        },
        {
          "label": "Caps and chains are present",
          "fieldType": "pass_fail_na",
          "required": true,
          "flaggable": true,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "severity": "minor",
            "autoWorkOrder": true
          }
        },
        {
          "label": "Paint and marker are visible",
          "fieldType": "pass_fail_na",
          "required": true,
          "flaggable": true,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "severity": "minor",
            "autoWorkOrder": true
          }
        }
      ]
    },
    {
      "title": "Operation",
      "items": [
        {
          "label": "Operating nut turns smoothly",
          "fieldType": "pass_fail_na",
          "required": true,
          "flaggable": true,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "severity": "major",
            "autoWorkOrder": true
          }
        },
        {
          "label": "Water flows when opened",
          "fieldType": "pass_fail_na",
          "required": true,
          "flaggable": true,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "severity": "critical",
            "autoWorkOrder": true
          }
        },
        {
          "label": "Drains properly after closing",
          "fieldType": "pass_fail_na",
          "required": true,
          "flaggable": true,
          "helperText": "Standing water left in the barrel can freeze.",
          "settings": {
            "allowEvidencePhotos": false,
            "severity": "major",
            "autoWorkOrder": true
          }
        },
        {
          "label": "Static pressure (kPa)",
          "fieldType": "number",
          "required": false,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        }
      ]
    },
    {
      "title": "Result and sign-off",
      "items": [
        {
          "label": "Overall result",
          "fieldType": "dropdown_select_one",
          "required": true,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "options": [
              "Safe to use",
              "Safe with minor items noted",
              "Not safe: taken out of use"
            ]
          }
        },
        {
          "label": "Notes and follow-up needed",
          "fieldType": "long_text",
          "required": false,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        },
        {
          "label": "Photo of any problem found",
          "fieldType": "photo",
          "required": false,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        },
        {
          "label": "Inspector signature",
          "fieldType": "signature",
          "required": true,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        }
      ]
    }
  ]
}