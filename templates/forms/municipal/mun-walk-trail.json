{
  "formCode": "MUN-WALK-TRAIL",
  "name": "Sidewalk and trail inspection",
  "description": "Patrol of a sidewalk or trail section for trip hazards and damage. Record each problem's location so the crew can find it.",
  "sections": [
    {
      "title": "Inspection details",
      "items": [
