          "label": "Date",
          "fieldType": "date",
          "required": true,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false
          }
        },
        {
          "label": "Inspected by",
          "fieldType": "worker_select",
          "required": true,
          "flaggable": false,
          "helperText": null,
          "settings": {
            "allowEvidencePhotos": false,
            "workerPickerScope": "current_worker"
          }
        },
